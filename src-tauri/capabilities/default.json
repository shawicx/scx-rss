{
  "$schema": "https://tauri.app/schemas/2.0.0/capability.json",
  "identifier": "default",
  "description": "Default capabilities for the application",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:path:allow-resolve",
    "core:path:allow-resolve-directory",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
