{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "SCX RSS Reader",
  "version": "0.1.0",
  "identifier": "com.scx.rss",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SCX RSS Reader",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/shawicx/scx-rss/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5M0EyQUMwOTZBMEQwRDEKUldUUjBLQ1d3Q282T1hUWVJhWXFZME4rTm0rVjFpQmE3cXFwZkZFMittT0NRcVhERTFJSVpZcDEK"
    }
  }
}
